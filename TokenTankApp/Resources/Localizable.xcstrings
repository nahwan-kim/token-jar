    "settings.updates.error" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The in-app updater could not start. Update checking is unavailable." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "앱 내 업데이트 도구를 시작할 수 없습니다. 업데이트 확인을 사용할 수 없습니다." } }
      }
    },
    "settings.updates.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Signed updates download, install, and relaunch Token Jar in-app after you approve the update. Automatic checks never install updates without your approval." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "서명된 업데이트는 사용자가 승인한 뒤 앱 안에서 다운로드·설치되고 토큰 항아리가 다시 시작됩니다. 자동 확인은 승인 없이 업데이트를 설치하지 않습니다." } }
      }
    },
    "settings.updates.gatekeeper" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Updates are signed, but downloads may be unnotarized, so macOS Gatekeeper may require explicit approval." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "업데이트에는 서명이 있지만 다운로드한 앱은 공증되지 않았을 수 있어 macOS Gatekeeper에서 명시적 승인이 필요할 수 있습니다." } }
      }
    },
    "settings.updates.privacy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatic checks use the signed GitHub feed. GitHub can see your connection IP address; Token Jar sends no account or usage data and does not profile you." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "자동 확인은 GitHub의 서명된 피드에 연결합니다. GitHub는 연결 IP 주소를 볼 수 있으며, 토큰 항아리는 계정이나 사용량 데이터를 보내지 않고 프로파일링하지 않습니다." } }
      }
    },
    "source.detail.claude" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Live Claude usage through the native Claude Code OAuth session. Claude refreshes can recover the session and may ask for native Keychain permission; use Repair Claude Connection to retry immediately." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "네이티브 Claude Code OAuth 세션으로 라이브 사용량을 조회합니다. Claude 갱신 중 세션을 복구하며 네이티브 키체인 권한을 요청할 수 있습니다. 즉시 다시 시도하려면 Claude 연결 복구를 사용하세요." } }
      }
    },
    "source.detail.codex" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Official Codex app-server rate limits. Sign in through Codex; Token Jar never reads or changes its credentials." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "공식 Codex app-server 사용 한도입니다. Codex에서 로그인하며 토큰 항아리는 자격 증명을 읽거나 변경하지 않습니다." } }
      }
    },
    "source.detail.cursor" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Read-only Cursor.app session and usage summary. Sign in through Cursor; undocumented schema changes fail closed." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Cursor.app 세션과 사용량 요약을 읽기 전용으로 사용합니다. Cursor에서 로그인하며 비공개 스키마 변경 시 안전하게 중단됩니다." } }
      }
    },
    "source.detail.doubao" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Official arkcli plan usage. Sign in through arkcli auth login; Token Jar never copies Volcengine credentials." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "공식 arkcli 플랜 사용량입니다. arkcli auth login으로 로그인하며 토큰 항아리는 Volcengine 자격 증명을 복사하지 않습니다." } }
      }
    },
    "source.detail.grok" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Grok CLI SuperGrok credits for each signed-in account. Token Jar only reads ~/.grok/auth.json; when a session expires it runs the Grok CLI once so the CLI renews it. Run grok login if the login was revoked. Browser cookies are not imported." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "로그인된 계정별 Grok CLI SuperGrok 크레딧입니다. ~/.grok/auth.json은 읽기만 하며, 세션이 만료되면 Grok CLI를 한 번 실행해 CLI가 직접 갱신하게 합니다. 로그인이 해제된 경우 grok login으로 다시 로그인하세요. 브라우저 쿠키는 가져오지 않습니다." } }
      }
    },
