    "source.detail.claude" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Read-only Claude Code local usage cache. Sign in through Claude; Token Tank never reads its credentials." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code 로컬 사용량 캐시를 읽기 전용으로 사용합니다. Claude에서 로그인하며 Token Tank는 자격 증명을 읽지 않습니다." } }
      }
    },
    "source.detail.codex" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Official Codex app-server rate limits. Sign in through Codex; Token Tank never reads or changes its credentials." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "공식 Codex app-server 사용 한도입니다. Codex에서 로그인하며 Token Tank는 자격 증명을 읽거나 변경하지 않습니다." } }
      }
    },
    "source.detail.cursor" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Read-only Cursor.app session and usage summary. Sign in through Cursor; undocumented schema changes fail closed." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Cursor.app 세션과 사용량 요약을 읽기 전용으로 사용합니다. Cursor에서 로그인하며 비공개 스키마 변경 시 안전하게 중단됩니다." } }
      }
    },
    "source.detail.doubao" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Official arkcli plan usage. Sign in through arkcli auth login; Token Tank never copies Volcengine credentials." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "공식 arkcli 플랜 사용량입니다. arkcli auth login으로 로그인하며 Token Tank는 Volcengine 자격 증명을 복사하지 않습니다." } }
      }
    },
